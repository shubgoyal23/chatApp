PORT=3000
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173
# Parent domain shared by the frontend, API and socket server (leave empty for localhost)
COOKIE_DOMAIN=
# "none" when the frontend is on a different site than the API, otherwise "lax"
COOKIE_SAMESITE=none
# Only set to false for plain-http local development
COOKIE_SECURE=true
# Number of reverse proxies in front of the API (nginx = 1). Used for client IPs
# in rate limiting; set to 0 if the API is exposed directly.
TRUST_PROXY=1

# MongoDB (connects to ${MONGODB_URI}/${MONGO_DB})
MONGODB_URI=mongodb://localhost:27017
MONGO_DB=chatapp

# Redis (host:port). Leave username empty to use the default user.
REDIS_HOST=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
# Prepended to every key; must be the same in api_server and socket_server
REDIS_PREFIX=chatapp:

# JWT — use long random values (e.g. `openssl rand -hex 32`)
ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Worker API (see email.md). In docker compose, use the worker's
# container name on the shared email_network, e.g. http://email-worker:3000
EMAIL_WORKER_URL=http://email-worker:3000
EMAIL_WORKER_KEY=ew_xxxxxxxxxxxxxxxx
# Optional: must be an SES-verified sender; omit to use the worker's default
EMAIL_FROM=Chatzz <chatzz@shubhamgoyal.dev>
