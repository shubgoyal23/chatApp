PORT_GIN=3000
GIN_MODE=release
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173
VM_ID=1

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGO_DB=chatapp

# Redis (host:port). Leave username empty to use the default user.
REDIS_HOST=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
# Prepended to every key; must be the same in api_server and socket_server
REDIS_PREFIX=chatapp:

# Must match the api_server's ACCESS_TOKEN_SECRET
ACCESS_TOKEN_SECRET=change-me
