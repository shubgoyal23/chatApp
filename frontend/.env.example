# REST API base, including the /api/v1 prefix
VITE_API_URL=http://localhost:8000/api/v1
# Socket server (http(s) URLs are converted to ws(s) automatically)
VITE_WS_URL=http://localhost:3000
VITE_GIN_URL=http://localhost:3000

# Optional: TURN server for calls between users behind strict NATs/firewalls
# (comma-separated URLs, e.g. turn:turn.example.com:3478?transport=udp)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional: override the Cloudinary delivery base used for avatars
VITE_CLOUDINARY_URL=
